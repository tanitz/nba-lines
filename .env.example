# คีย์จาก https://the-odds-api.com (สมัครฟรีได้)
ODDS_API_KEY=ใส่คีย์ของคุณตรงนี้

# ภูมิภาคเจ้ามือ: us, us2, uk, eu, au (คั่นด้วย , ได้ แต่ทุกภูมิภาคคิดเครดิตเพิ่ม)
# eu มี Pinnacle ซึ่งเป็นราคาอ้างอิงที่นิยมใช้
REGIONS=eu
# หรือระบุเจ้ามือเองแทนภูมิภาค (ทุก 10 เจ้าคิดเป็น 1 ภูมิภาค) เช่น pinnacle,betfair_ex_eu
BOOKMAKERS=

# เจ้ามือที่ให้หน้าเว็บเลือกเป็นค่าเริ่มต้น (ว่าง = ค่ากลางตลาด)
DEFAULT_BOOK=pinnacle

PORT=3000
DB_PATH=./data/odds.db

# ความถี่การดึงราคา (นาที) ตามระยะเวลาก่อนแข่งของแมตช์ที่ใกล้ที่สุด
# ค่าด้านล่างใช้ราว 4,000 เครดิต/เดือน ช่วงฤดูกาล (เหมาะกับแผน 20K)
# แผนฟรี 500 เครดิต ให้ใช้: FAR=1440 DAY=720 NEAR=240 CLOSE=60 IDLE=1440 SCORES_EVERY_HOURS=24 (ราว 7 ครั้ง/วัน)
POLL_FAR_MIN=180     # เหลือมากกว่า 24 ชม.
POLL_DAY_MIN=60      # 6-24 ชม.
POLL_NEAR_MIN=20     # 1-6 ชม.
POLL_CLOSE_MIN=10    # น้อยกว่า 1 ชม.
POLL_IDLE_MIN=360    # ไม่มีแมตช์ที่รู้จัก (ช่วงปิดฤดูกาล)

# ดึงผลการแข่งขันทุกกี่ชั่วโมง (0 = ปิด)
SCORES_EVERY_HOURS=4
# ตารางแข่ง (ไม่เสียเครดิต) ดึงทุกกี่นาที 0 = ปิด
EVENTS_EVERY_MIN=60

# หยุดดึงเมื่อเครดิตคงเหลือต่ำกว่าค่านี้
MIN_CREDITS_LEFT=25

# รหัสสำหรับกดปุ่ม "ดึงราคาตอนนี้" บนหน้าเว็บ (ว่าง = ปิดปุ่มนี้)
ADMIN_TOKEN=
